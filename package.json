{
  "name": "gulp-ts-compile",
  "version": "1.0.2",
  "description": "A minimal gulp-typescript replacement built directly on the TypeScript Compiler API's stable, public surface.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest",
    "lint": "eslint --fix src eslint.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jheagle/gulp-ts-compile.git"
  },
  "keywords": [
    "gulp",
    "gulpplugin",
    "typescript",
    "compile"
  ],
  "author": "Joshua Heagle <joshuaheagle@gmail.com>",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/jheagle/gulp-ts-compile/issues"
  },
  "homepage": "https://github.com/jheagle/gulp-ts-compile#readme",
  "dependencies": {
    "vinyl": "^3.0.1"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "neostandard": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/index.js"
  ],
  "allowScripts": {
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
